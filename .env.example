# Copy to .env to override the development defaults in docker-compose.yml.
# Role passwords are only applied when the database volume is first created;
# after changing them run `docker compose down -v` (this deletes all data).
POSTGRES_DB=ordertracker
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password
MIGRATOR_DB_USER=ordertracker_migrator
MIGRATOR_DB_PASSWORD=migrator_dev_password
APP_DB_USER=ordertracker_app
APP_DB_PASSWORD=app_dev_password

WEB_PORT=8080
API_PORT=8081
DB_PORT=5433
